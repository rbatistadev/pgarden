generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String        @id @default(uuid())
  email            String        @unique
  name             String
  createdAt        DateTime      @default(now())
  companyId        String?
  passwordHash     String
  refreshTokenHash String?
  role             Role          @default(USER)
  Absence          Absence[]
  WorkSession      WorkSession[]
  company          Company?      @relation(fields: [companyId], references: [id])
}

model Company {
  id        String     @id @default(uuid())
  name      String     @unique
  Agreement Agreement?
  users     User[]
}

model WorkSession {
  id       String   @id @default(uuid())
  userId   String
  startAt  DateTime
  endAt    DateTime?
  metadata Json?
  user     User     @relation(fields: [userId], references: [id])
}

model Agreement {
  id           String  @id @default(uuid())
  companyId    String  @unique
  vacationDays Int
  medicalDays  Int
  deathDays    Int
  movingDays   Int
  company      Company @relation(fields: [companyId], references: [id])
}

model Absence {
  id        String      @id @default(uuid())
  userId    String
  type      AbsenceType
  startDate DateTime
  endDate   DateTime
  days      Int
  approved  Boolean     @default(false)
  user      User        @relation(fields: [userId], references: [id])
}

enum AbsenceType {
  VACATION
  MEDICAL
  DEATH
  MOVING
}

enum Role {
  ADMIN
  MANAGER
  USER
}
